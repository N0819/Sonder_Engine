__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.venv-browser/
venv/
*.db
*.db-wal
*.db-shm
# A backup taken before an edit to live story data is still live story
# data, and it is two gigabytes of it. `*.db` does not match
# `engine.db.backup-...`, so `git add -A` spent its time hashing one.
*.db.backup*
*.db.bak
*.sqlite
*.sqlite3
.env
.claude/settings.local.json
.DS_Store

# Agent worktrees live inside the repo; never commit them
.claude/worktrees/
demo/tavern_scene_life/run.db*
demo/tavern_scene_life/run_out.txt
demo/trek_bridge_scene_life/run.db*
demo/trek_bridge_scene_life/run_out.txt
engine.test.db*
backdrops/
# Fetched ambience beds, and the host's own sound library if they put it here.
# Both are media, not source: the cache is reconstructible from the manifests'
# queries, and a personal library may be licensed material the host bought.
ambience/
ambience_library/

# Scene/chat blobs dumped out of a live playthrough while debugging. These are
# play content, not engine source -- one was picked up by a release rsync and
# very nearly published. Untracked is not enough on its own: the release path
# copies the working tree wholesale, so anything not ignored here ships.
*_backup_*.json
scene_chat*.json

# Pipeline diagnostics can contain story text, retrieved lore, and private
# character reasoning when exported with --include-content. Keep generated
# traces local unless someone deliberately renames/adds a scrubbed fixture.
*.trace.json
# Bench output: generated narrator prose, i.e. content-bearing
# diagnostics, same class as the trace files above.
tools/paragraph_bench_last.json

# Written into the agent worktree by the assistant sync script.
SYNCED.txt

# Installed extensions belong to the host, not to the repo: `/api/extensions/
# install` writes third-party code straight into this directory, and it must
# not turn up in `git status` as if it were the engine's own. The two reference
# extensions are the deliberate exception -- docs/guides/EXTENSIONS.md points at
# them as the worked examples, so they ship.
/extensions/*
!/extensions/cohesion-demo/
!/extensions/overlay-demo/
